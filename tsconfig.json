{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": [
    "src/routes/*.tsx",
    "src/components/site/**/*.tsx",
    "src/lib/site.ts",
    "src/assets/**/*.json"
  ]
}
